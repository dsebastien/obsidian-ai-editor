{
    "compilerOptions": {
        "baseUrl": ".",
        "lib": ["DOM", "ESNext"],
        // Ambient type packages, named EXPLICITLY rather than left to
        // TypeScript's automatic `node_modules/@types` scan.
        //
        // The scan only looks at the TOP LEVEL, and `@types/node` used to
        // arrive here transitively (via `@types/bun` -> `bun-types`), which a
        // package manager is free to nest instead of hoist. When that happened
        // in the community-catalog reviewer's install, every `node:*` import
        // silently became an `error` type and produced ~80 `no-unsafe-*`
        // warnings we could not see locally (0.5.0 review). Both packages are
        // now direct, pinned devDependencies and named here, so a missing one
        // is a hard tsc failure instead of a silent degradation to `any`.
        "types": ["bun", "node"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleDetection": "force",
        // Bundler mode
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "importHelpers": true,
        "inlineSources": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "checkJs": false,

        // Maximum strictness
        "strict": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noPropertyAccessFromIndexSignature": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "skipLibCheck": true,

        // Output
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "noEmitOnError": true,
        "sourceMap": true
    },
    "include": ["src/**/*", "eslint.config.ts", "commitlint.config.ts"],
    "exclude": ["node_modules", "dist"]
}
